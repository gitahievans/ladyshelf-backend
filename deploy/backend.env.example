# Compose deployment contract
BACKEND_IMAGE=harbor.example.com/ladyshelf/backend:replace-with-immutable-tag
BACKEND_ENV_FILE=/opt/ladyshelf/secrets/backend.env
BACKEND_PORT=8000

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=api.ladyshelf.site
DJANGO_CORS_ALLOWED_ORIGINS=https://ladyshelf.site,https://www.ladyshelf.site
DJANGO_CSRF_TRUSTED_ORIGINS=https://api.ladyshelf.site,https://ladyshelf.site,https://www.ladyshelf.site
DJANGO_TIME_ZONE=Africa/Nairobi
DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_STRUCTURED=true
DJANGO_ADMINS=Store Owner:owner@ladyshelf.site
DJANGO_USE_X_FORWARDED_HOST=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_DB_CONN_MAX_AGE=60

# Gunicorn
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100

# PostgreSQL
DJANGO_DB_ENGINE=django.db.backends.postgresql
POSTGRES_DB=wahi_fashion
POSTGRES_USER=wahi
POSTGRES_PASSWORD=replace-with-a-long-random-value
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_VOLUME_NAME=ladyshelf_postgres_data

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SERVICE_ROLE_KEY=
PRODUCT_IMAGES_BUCKET=product-images

# AI product images (disabled until separately configured and approved)
IMAGE_GENERATION_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-4b
CLOUDFLARE_AI_TIMEOUT_SECONDS=90

# Email and notifications
DJANGO_DEFAULT_FROM_EMAIL=orders@ladyshelf.site
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=replace-me
DJANGO_EMAIL_HOST_PASSWORD=replace-me
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
ORDER_NOTIFICATION_STAFF_EMAILS=orders@ladyshelf.site

# SasaPay
SASAPAY_BASE_URL=https://sandbox.sasapay.app
SASAPAY_CLIENT_ID=replace-me
SASAPAY_CLIENT_SECRET=replace-me
SASAPAY_MERCHANT_CODE=replace-me
SASAPAY_CALLBACK_URL=https://api.ladyshelf.site/api/v1/payments/sasapay/callback
SASAPAY_TIMEOUT_SECONDS=30
PREPAID_ORDER_EXPIRY_MINUTES=30
